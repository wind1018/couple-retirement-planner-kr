<Window x:Class="NpsSimulator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="국민연금 부부 종합 시뮬레이터" Width="1280" Height="850"
        MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ClaimAgeOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="1" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder" Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#2563EB" />
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#1D4ED8" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Background="White">
        <Border DockPanel.Dock="Top" Background="#0B1220" Padding="22,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="국민연금 부부 종합 시뮬레이터" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="독립 실행 · 서버 없음 · 기본 저장 안 함 · Anchor Mode 추정" Foreground="#AFC6FF" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#123B2A" CornerRadius="6" Padding="14,9">
                    <StackPanel>
                        <TextBlock Text="● 오프라인 계산" Foreground="#7EE2A8" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderPolicyText" Foreground="#D1FAE5" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F3F4F6">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="준비" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="입력값은 사용자가 저장을 선택하기 전까지 파일로 남기지 않습니다." Foreground="#4B5563" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" Margin="14">
            <TabItem Header="1. 공단 정보 입력">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" Foreground="#1E3A8A">
                                <Run FontWeight="SemiBold">NPS 앱에서 그대로 옮길 값:</Run><LineBreak />
                                <Run>① 생년월일  ② 세전 월 예상연금  ③ 총 예상납부액  ④ 가입 시작 연월·종료 연월·총 개월</Run><LineBreak />
                                <Run>정상 수급 시작월, 가입 공백 후보, 월평균 비용과 유족연금은 프로그램이 자동 계산합니다.</Run>
                            </TextBlock>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Padding="14">
                                <GroupBox.Header>
                                    <CheckBox x:Name="HasPensionAInput"
                                              Content="본인(A) · 국민연금 가입/예상연금 있음"
                                              IsChecked="True"
                                              Checked="PensionParticipation_Changed"
                                              Unchecked="PensionParticipation_Changed" />
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="표시 이름" /><TextBox x:Name="AliasAInput" Text="본인" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="생년월일(8자리)" /><TextBox x:Name="BirthDateAInput" MaxLength="8" TextChanged="BirthDateInput_Changed" ToolTip="예: 19750222" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                        <TextBlock Text="총 예상 가입기간" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="44" /><ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="66" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="58" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ContributionStartYearAInput" MaxLength="4" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 1999" />
                                            <TextBlock Grid.Column="1" Text="년" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox Grid.Column="2" x:Name="ContributionStartMonthAInput" MaxLength="2" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 04" />
                                            <TextBlock Grid.Column="3" Text="월" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBlock Grid.Column="4" Text="~" VerticalAlignment="Center" Margin="7,0" />
                                            <TextBox Grid.Column="5" x:Name="ContributionEndYearAInput" MaxLength="4" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 2035" />
                                            <TextBlock Grid.Column="6" Text="년" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox Grid.Column="7" x:Name="ContributionEndMonthAInput" MaxLength="2" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 02" />
                                            <TextBlock Grid.Column="8" Text="월" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBlock Grid.Column="9" Text="총" VerticalAlignment="Center" Margin="7,0,4,0" />
                                            <TextBox Grid.Column="10" x:Name="ExpectedMonthsAInput" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 418" />
                                            <TextBlock Grid.Column="11" Text="개월" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                    <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,3,0,8">
                                        <TextBlock x:Name="ClaimMonthAInfo" Text="정상 수급 시작월: 생년월일 입력 후 자동 계산" Foreground="#1E3A8A" TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="세전 월 예상연금(공단 표시값)" /><TextBox x:Name="AnchorPensionAInput" TextChanged="MoneyInput_TextChanged" ToolTip="숫자만 입력하면 천 단위 쉼표가 자동으로 붙습니다." />
                                        <TextBlock x:Name="EstimatedNetPensionAInfo" Text="세후 추정: 세전액 입력 후 자동 계산" Foreground="#1E3A8A" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="총 예상납부액(공단 표시값)" /><TextBox x:Name="TotalContributionAInput" TextChanged="MoneyInput_TextChanged" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" x:Name="GapCandidateAInfo" Text="가입 공백 후보: 기간과 총 개월 입력 후 계산"
                                               Foreground="#9A3412" TextWrapping="Wrap" Margin="0,4,0,0" MinHeight="34" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Column="2" Padding="14">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="IncludeSpouseBInput"
                                                  Content="배우자 있음 · 유족연금 계산"
                                                  IsChecked="True"
                                                  Checked="SpouseInclusion_Changed"
                                                  Unchecked="SpouseInclusion_Changed" />
                                        <CheckBox x:Name="HasPensionBInput"
                                                  Content="배우자 본인 국민연금 있음"
                                                  IsChecked="True"
                                                  Margin="18,0,0,0"
                                                  Checked="PensionParticipation_Changed"
                                                  Unchecked="PensionParticipation_Changed" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="표시 이름" /><TextBox x:Name="AliasBInput" Text="배우자" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="생년월일(8자리)" /><TextBox x:Name="BirthDateBInput" MaxLength="8" TextChanged="BirthDateInput_Changed" ToolTip="예: 19750222" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                        <TextBlock Text="총 예상 가입기간" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="44" /><ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="66" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="58" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ContributionStartYearBInput" MaxLength="4" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 1999" />
                                            <TextBlock Grid.Column="1" Text="년" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox Grid.Column="2" x:Name="ContributionStartMonthBInput" MaxLength="2" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 04" />
                                            <TextBlock Grid.Column="3" Text="월" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBlock Grid.Column="4" Text="~" VerticalAlignment="Center" Margin="7,0" />
                                            <TextBox Grid.Column="5" x:Name="ContributionEndYearBInput" MaxLength="4" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 2035" />
                                            <TextBlock Grid.Column="6" Text="년" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBox Grid.Column="7" x:Name="ContributionEndMonthBInput" MaxLength="2" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 02" />
                                            <TextBlock Grid.Column="8" Text="월" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBlock Grid.Column="9" Text="총" VerticalAlignment="Center" Margin="7,0,4,0" />
                                            <TextBox Grid.Column="10" x:Name="ExpectedMonthsBInput" TextChanged="NpsPeriodParts_Changed" ToolTip="예: 418" />
                                            <TextBlock Grid.Column="11" Text="개월" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                    <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,3,0,8">
                                        <TextBlock x:Name="ClaimMonthBInfo" Text="정상 수급 시작월: 생년월일 입력 후 자동 계산" Foreground="#1E3A8A" TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="세전 월 예상연금(공단 표시값)" /><TextBox x:Name="AnchorPensionBInput" TextChanged="MoneyInput_TextChanged" ToolTip="숫자만 입력하면 천 단위 쉼표가 자동으로 붙습니다." />
                                        <TextBlock x:Name="EstimatedNetPensionBInfo" Text="세후 추정: 세전액 입력 후 자동 계산" Foreground="#1E3A8A" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="총 예상납부액(공단 표시값)" /><TextBox x:Name="TotalContributionBInput" TextChanged="MoneyInput_TextChanged" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" x:Name="GapCandidateBInfo" Text="가입 공백 후보: 기간과 총 개월 입력 후 계산"
                                               Foreground="#9A3412" TextWrapping="Wrap" Margin="0,4,0,0" MinHeight="34" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                        <Expander Header="선택 입력(모르면 열지 않아도 됩니다)" Margin="0,14,0,0">
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="모르면 비워 두세요. 현재 월 보험료가 없으면 총 예상납부액 ÷ 총 예상 가입개월을 비용 계산용 월평균으로 사용합니다."
                                               TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="본인 현재 월 보험료(알면 입력)" /><TextBox x:Name="PremiumAInput" TextChanged="MoneyInput_TextChanged" />
                                            <TextBlock Text="본인이 받을 월 유족연금 공단 확인값(알면 입력)" />
                                            <TextBox x:Name="SurvivorAInput" TextChanged="MoneyInput_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="배우자 현재 월 보험료(알면 입력)" /><TextBox x:Name="PremiumBInput" TextChanged="MoneyInput_TextChanged" />
                                            <TextBlock Text="배우자가 받을 월 유족연금 공단 확인값(알면 입력)" />
                                            <TextBox x:Name="SurvivorBInput" TextChanged="MoneyInput_TextChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="암호화 프로필 불러오기" Click="LoadProfile_Click" />
                            <Button Content="암호화 프로필 저장" Click="SaveProfile_Click" />
                            <Button Content="다음: 전략 입력·계산" Click="GoToStrategy_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2. 전략 분석 보고서">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="두 사람의 조건을 한 번만 입력하세요. 아래 보고서와 유족연금 시뮬레이션에 같은 조건이 자동으로 적용됩니다. (0년 선택 시 해당 항목은 계산에서 제외)"
                                       Foreground="#1E40AF" TextWrapping="Wrap" Margin="2,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <GroupBox Header="본인(A) 선택 전략" Padding="12">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <TextBlock Text="임의계속가입(0~5년)" VerticalAlignment="Center" /><ComboBox x:Name="SelectedContinueYearsAInput" Width="70" SelectionChanged="SelectedContinuationYears_Changed" />
                                            <TextBlock Text="년   월 납입액" VerticalAlignment="Center" /><TextBox x:Name="SelectedMonthlyPremiumAInput" Width="115" Text="150,000" TextChanged="MoneyInput_TextChanged" />
                                            <TextBlock Text="원" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TextBlock Text="연금 수령 나이 선택" FontWeight="SemiBold" Margin="0,2,0,4" />
                                        <UniformGrid x:Name="ClaimAgeAOptionsPanel" Columns="11" />
                                        <TextBlock x:Name="ClaimAgeAHelp" Foreground="#475569" FontSize="11" Margin="1,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Grid.Column="2" Header="배우자(B) 선택 전략" Padding="12">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <TextBlock Text="임의계속가입(0~5년)" VerticalAlignment="Center" /><ComboBox x:Name="SelectedContinueYearsBInput" Width="70" SelectionChanged="SelectedContinuationYears_Changed" />
                                            <TextBlock Text="년   월 납입액" VerticalAlignment="Center" /><TextBox x:Name="SelectedMonthlyPremiumBInput" Width="115" Text="150,000" TextChanged="MoneyInput_TextChanged" />
                                            <TextBlock Text="원" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TextBlock Text="연금 수령 나이 선택" FontWeight="SemiBold" Margin="0,2,0,4" />
                                        <UniformGrid x:Name="ClaimAgeBOptionsPanel" Columns="11" />
                                        <TextBlock x:Name="ClaimAgeBHelp" Foreground="#475569" FontSize="11" Margin="1,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                                <Button Grid.Column="3" Content="이 조건으로 계산" Click="RunSimulation_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="SemiBold" Margin="14,18,0,0" Padding="18,10" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="HTML 보고서 저장" Click="ExportHtml_Click" />
                        <Button Content="비교표 CSV 저장" Click="ExportCsv_Click" />
                        <Button Content="인쇄 / PDF 저장" Click="PrintResult_Click" />
                    </StackPanel>
                    <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                        <WebBrowser x:Name="ReportBrowser" />
                    </Border>
                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="ResultSummaryText" Text="선택 전략을 계산하면 종합 보고서가 표시됩니다." />
                        <TextBlock x:Name="WarningsText" />
                        <DataGrid x:Name="LedgerGrid" />
                        <TextBox x:Name="BackpayAInput" Text="0" /><TextBlock x:Name="BackpayCandidateAInfo" /><Button x:Name="UseGapCandidateAButton" Click="UseGapCandidateA_Click" />
                        <CheckBox x:Name="BackpayConfirmedAInput" /><ComboBox x:Name="ContinueAgeAInput" /><TextBox x:Name="ContinuePremiumAInput" Text="0" TextChanged="MoneyInput_TextChanged" /><ComboBox x:Name="ClaimOffsetAInput" DisplayMemberPath="Label" />
                        <TextBox x:Name="BackpayBInput" Text="0" /><TextBlock x:Name="BackpayCandidateBInfo" /><Button x:Name="UseGapCandidateBButton" Click="UseGapCandidateB_Click" />
                        <CheckBox x:Name="BackpayConfirmedBInput" /><ComboBox x:Name="ContinueAgeBInput" /><TextBox x:Name="ContinuePremiumBInput" Text="0" TextChanged="MoneyInput_TextChanged" /><ComboBox x:Name="ClaimOffsetBInput" DisplayMemberPath="Label" />
                        <ComboBox x:Name="ContinuationIncomeAInput" DisplayMemberPath="Label" SelectionChanged="ContinuationIncome_Changed" /><TextBox x:Name="CustomContinuationIncomeAInput" TextChanged="CustomContinuationIncome_Changed" /><TextBlock x:Name="ContinuationPremiumAInfo" />
                        <ComboBox x:Name="ContinuationIncomeBInput" DisplayMemberPath="Label" SelectionChanged="ContinuationIncome_Changed" /><TextBox x:Name="CustomContinuationIncomeBInput" TextChanged="CustomContinuationIncome_Changed" /><TextBlock x:Name="ContinuationPremiumBInfo" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="3. 유족연금 시뮬레이션">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" /><ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="본인(A) 예상 사망 나이" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="DeathAgeAInput" Grid.Column="1" Text="80" Margin="8,0" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="배우자(B) 예상 사망 나이" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="DeathAgeBInput" Grid.Column="4" Text="90" Margin="8,0" VerticalContentAlignment="Center" />
                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button Content="사망 나이 서로 바꾸기" Click="SwapDeathAges_Click" />
                                <Button Content="유족연금 자동 계산" Click="RunSurvivorAnalysis_Click" Background="#6D28D9" Foreground="White" FontWeight="SemiBold" />
                                <Button Content="HTML 저장" Click="ExportSurvivorHtml_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                        <WebBrowser x:Name="SurvivorReportBrowser" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="4. 정책 관리">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="현재 활성 정책" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="PolicySummaryText" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="개발자에게 요청하지 않고 AI와 직접 정책 갱신" FontWeight="SemiBold" FontSize="16" Margin="0,18,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="#4B5563">
                            업데이트 키트에는 공개 정책, Schema, AI 작성 지침만 들어가며 개인 프로필과 계산 결과는 포함되지 않습니다. AI에서 받은 JSON은 프로그램의 변경 불가능한 검증을 통과해야 활성화됩니다.
                        </TextBlock>
                        <WrapPanel Margin="0,12,0,4">
                            <Button Content="1. AI 업데이트 키트 만들기" Click="ExportAiKit_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" />
                            <Button Content="2. AI 정책 JSON 검사·가져오기" Click="ImportPolicy_Click" />
                            <Button x:Name="ExportFixKitButton" Content="3. AI 수정 요청 키트 만들기" Click="ExportFixKit_Click" IsEnabled="False" />
                            <Button Content="4. 이전 정책으로 되돌리기" Click="RollbackPolicy_Click" />
                        </WrapPanel>
                        <GroupBox Header="최근 정책 검사 결과" Margin="0,14,0,0" Padding="12">
                            <TextBox x:Name="PolicyValidationText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" MinHeight="240" FontFamily="Consolas" />
                        </GroupBox>
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="#9A3412">
                                ‘사용자 가져오기·검증 통과’는 기술 검증을 통과했다는 뜻이며 국민연금공단의 인증을 의미하지 않습니다. 실제 보험료와 급여는 공단 산정 결과가 우선합니다.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
